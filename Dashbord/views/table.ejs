<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Submitted Data</title>
</head>
<body>
  <%- include('header') %>

  <h2>Submitted Data</h2>

  <% if (submittedData) { %>
    <table border="1">
      <tr>
        <th>Name</th>
        <th>Email</th>
      </tr>
      <tr>
        <td><%= submittedData.name %></td>
        <td><%= submittedData.email %></td>
      </tr>
    </table>
  <% } else { %>
    <p>No data submitted yet!</p>
  <% } %>

  <%- include('footer') %>
</body>
</html>
