<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <style>
    /* Basic reset */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

/* Header styles */
header {
  text-align: center;
  padding: 20px 0;
  background-color: #fff;
}

/* Title styling */
header h1 {
  font-size: 24px;
  margin-bottom: 10px;
  font-family: Arial, sans-serif;
}

/* Navigation list styling */
nav ul {
  list-style: none;
  display: flex;
  justify-content: center;
  gap: 40px;
  font-family: Arial, sans-serif;
}

/* Navigation links */
nav a {
  text-decoration: none;
  color: #333;
  font-weight: 500;
  letter-spacing: 1px;
  transition: color 0.3s ease;
}

/* Hover effect */
nav a:hover {
  color: #007BFF; /* Optional: change to any hover color */
}

  </style>
</head>
<body>
  <header>
  <h1>Dashboard</h1>
  <nav>
    <ul>
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/form">Form</a></li>
      <li><a href="/table">Table</a></li>
    </ul>
  </nav>
</header>

</body>
</html>